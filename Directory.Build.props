<Project>
    <!-- The versions of the packages this repository's projects reference -->
    <Import Project="$(MSBuildThisFileDirectory)eng\Versions.props" />

    <!-- Built for a game: output in the game's folder, so games build at the same time (eng/DotGame.BuildRoot.props) -->
    <Import Project="$(MSBuildThisFileDirectory)eng\DotGame.BuildRoot.props" />

    <PropertyGroup>
        <!-- The framework's repository, this one: what libraries built on it find it by -->
        <DotGameFrameworkDir Condition="'$(DotGameFrameworkDir)' == ''">$(MSBuildThisFileDirectory)</DotGameFrameworkDir>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- The compiler reports unneeded usings (IDE0005) only with a documentation file; doc comments are required only of the public projects (eng/DotGame.PublicApi.props) -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
    </PropertyGroup>

    <!-- Game code's build rules (no reflection or LINQ, no vulnerable packages); not for the content pipeline's build-time tools, the tests or the analyzers -->
    <Import Project="$(MSBuildThisFileDirectory)eng\DotGame.BuildPolicy.props"
                    Condition="'$(DotGameBuildPolicyImported)' != 'true' And !$(MSBuildProjectName.Contains('ContentPipeline')) And !$(MSBuildProjectName.EndsWith('.Tests')) And !$(MSBuildProjectName.EndsWith('.Analyzers')) And !$(MSBuildProjectDirectory.Contains('\native\'))" />

</Project>
