<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <InvariantTimezone>true</InvariantTimezone>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>DotGame.Framework.WebGL</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>DotGame.Framework.Desktop</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>DotGame.Framework.Android</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>DotGame.Framework.iOS</_Parameter1>
        </AssemblyAttribute>
        <!-- The framework's tests, which drive GameHost as a platform does -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>DotGame.Framework.Tests</_Parameter1>
        </AssemblyAttribute>
        <!--
            The test platform (test/DotGame.Framework.Testing), a platform of fakes. Code built on the
            framework tests through it, so the framework names nothing built on it.
        -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>DotGame.Framework.Testing</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <Import Project="..\eng\DotGame.PublicApi.props" />
</Project>
