<Project>

    <!--
        The web platform's JavaScript (_dotgame/*.js), registered at the game's build as the game's own
        static web assets, as the content pipeline registers content. From source, the WebGL project
        contributes them as a referenced project's assets; packed the way the WebAssembly SDK packs a
        library, the page asked for an unfingerprinted _dotgame/main.js, which returned 404, and the
        framework's files were published twice.
        They keep the paths and fingerprints they have from source: _dotgame/<name>.<fingerprint>.js.
    -->
    <PropertyGroup>
        <ResolveStaticWebAssetsInputsDependsOn>
            $(ResolveStaticWebAssetsInputsDependsOn);
            _DotGameRegisterWebScripts;
        </ResolveStaticWebAssetsInputsDependsOn>
    </PropertyGroup>

    <UsingTask TaskName="_StripScriptComments" AssemblyFile="$(FrameworkContentPipelineTasksAssembly)" />

    <Target Name="_DotGameRegisterWebScripts" Condition="'$(StaticWebAssetsSdkBuildTasksAssembly)' != ''">
        <PropertyGroup>
            <_DotGameWebScriptsRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\web\'))</_DotGameWebScriptsRoot>
        </PropertyGroup>
        <ItemGroup>
            <_DotGameWebScript Include="$(_DotGameWebScriptsRoot)_dotgame\*.js" />
        </ItemGroup>

        <!-- Release serves them without their comments and indentation, as from source
             (platform/webgl/DotGame.Framework.WebGL.csproj, _StripWebScriptComments) -->
        <PropertyGroup Condition="'$(Configuration)' == 'Release'">
            <_DotGameWebScriptsRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)dotgame-scripts/'))</_DotGameWebScriptsRoot>
        </PropertyGroup>
        <_StripScriptComments Condition="'$(Configuration)' == 'Release'"
                              Scripts="@(_DotGameWebScript)"
                              OutputDirectory="$(_DotGameWebScriptsRoot)_dotgame">
            <Output TaskParameter="StrippedScripts" ItemName="_DotGameStrippedWebScript" />
        </_StripScriptComments>
        <ItemGroup Condition="'$(Configuration)' == 'Release'">
            <_DotGameWebScript Remove="@(_DotGameWebScript)" />
            <_DotGameWebScript Include="@(_DotGameStrippedWebScript)" />
            <FileWrites Include="@(_DotGameStrippedWebScript)" />
        </ItemGroup>

        <ItemGroup>
            <_DotGameWebScriptCandidate Include="@(_DotGameWebScript)" RelativePath="_dotgame/%(Filename)#[.{fingerprint}]!%(Extension)" />
        </ItemGroup>

        <DefineStaticWebAssets
            CandidateAssets="@(_DotGameWebScriptCandidate)"
            SourceType="Computed"
            SourceId="$(PackageId)"
            ContentRoot="$(_DotGameWebScriptsRoot)"
            BasePath="$(StaticWebAssetBasePath)"
            AssetKind="All"
            AssetMode="CurrentProject"
            AssetRole="Primary"
            AssetMergeSource="$(StaticWebAssetMergeTarget)"
            FingerprintCandidates="false"
            CopyToOutputDirectory="Never"
            CopyToPublishDirectory="PreserveNewest">
            <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
            <Output TaskParameter="Assets" ItemName="_DotGameWebScriptAsset" />
        </DefineStaticWebAssets>

        <DefineStaticWebAssetEndpoints
            CandidateAssets="@(_DotGameWebScriptAsset)"
            ExistingEndpoints="@(StaticWebAssetEndpoint)"
            ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
            <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
        </DefineStaticWebAssetEndpoints>
    </Target>

</Project>
