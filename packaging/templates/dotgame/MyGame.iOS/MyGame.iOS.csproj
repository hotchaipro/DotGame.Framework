<Project Sdk="Microsoft.NET.Sdk">

    <!-- iOS: Metal. Needs the ios workload, and a Mac with Xcode. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0-ios</TargetFramework>
        <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
        <RootNamespace>MyGame</RootNamespace>
        <ApplicationId>com.example.mygame</ApplicationId>
        <ApplicationTitle>MyGame</ApplicationTitle>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DotGame.Framework.iOS" Version="$(DotGameVersion)" />
    </ItemGroup>

    <!-- The game's code, shared by every platform: a shared project, compiled into each platform's -->
    <Import Project="..\MyGame\MyGame.projitems" Label="Shared" />

    <!--
        The game's content, which the content pipeline builds for this platform. LinkBase names each item: a
        game loads it by its path under Content, with no extension, as in Content.LoadAsync<Texture>("Textures/ball").
    -->
    <ItemGroup>
        <LaunchScreen Include="..\Content\LaunchScreen\logo.png" Background="#181c28" LogoSize="140" />
        <TextureContent Include="..\Content\Textures\*.png">
            <LinkBase>Content\Textures</LinkBase>
        </TextureContent>
        <SoundContent Include="..\Content\Sound\*.wav">
            <LinkBase>Content\Sound</LinkBase>
        </SoundContent>
        <MusicContent Include="..\Content\Music\*.wav;..\Content\Music\*.flac">
            <LinkBase>Content\Music</LinkBase>
        </MusicContent>
    </ItemGroup>

</Project>
