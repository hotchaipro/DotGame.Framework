<?xml version="1.0" encoding="utf-8"?>
<!--
    Properties pane (browse object) for MusicContent items.
    See ContentPipeline.TextureContent.BrowseObject.xaml for why each rule
    lives in its own file.  Registered by ContentPipeline.targets.
-->
<Rule Name="MusicContent"
      DisplayName="Music Content"
      PageTemplate="generic"
      Description="Music track streamed at runtime, encoded by the content pipeline."
      xmlns="http://schemas.microsoft.com/build/2009/properties">

  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="False" ItemType="MusicContent" />
  </Rule.DataSource>

  <Rule.Categories>
    <Category Name="ContentPipeline" DisplayName="Content Pipeline" />
    <Category Name="Advanced" DisplayName="Advanced" />
    <Category Name="Misc" DisplayName="Misc" />
  </Rule.Categories>

  <DynamicEnumProperty Name="{}{ItemType}"
                       DisplayName="Build Action"
                       Category="Advanced"
                       Description="How the file relates to the build and deployment processes."
                       EnumProvider="ItemTypes" />

  <!--
    No Compression property: music is always lossy.  The default LossyQuality is 5
    rather than the 8 used for textures and sound because music is usually the
    largest content class and is streamed rather than held in memory, so extra
    bitrate costs more download than it buys audibly.
  -->
  <IntProperty Name="LossyQuality"
               DisplayName="Lossy Quality"
               Description="Quality scale 1..10 (default 5) for the lossy music encode. Higher is better quality and a larger file."
               Category="ContentPipeline"
               MinValue="1"
               MaxValue="10" />

  <EnumProperty Name="LossyFormat"
                DisplayName="Lossy Format"
                Description="The platform's own music format (default: Opus on the web, desktop and Android, AAC on iOS), or Opus on every platform: smaller than AAC, but iOS decodes it with more CPU."
                Category="ContentPipeline">
    <EnumValue Name="Default" DisplayName="Default" IsDefault="true" />
    <EnumValue Name="Opus" DisplayName="Opus" />
  </EnumProperty>

  <BoolProperty Name="Preload"
                DisplayName="Preload"
                Description="Whether the game needs this before its first frame (default false). On the web, the page starts downloading it at once, alongside the game's code; elsewhere content is read from the app, so it changes nothing."
                Category="ContentPipeline" />

  <StringProperty Name="Identity" Visible="false" ReadOnly="true" Category="Misc"
                  Description="The item specified in the Include attribute.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="MusicContent" PersistedName="Identity" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="FullPath" DisplayName="Full Path" ReadOnly="true" Category="Misc"
                  Description="Location of the file.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="MusicContent" PersistedName="FullPath" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="FileNameAndExtension" DisplayName="File Name" ReadOnly="true" Category="Misc"
                  Description="Name of the file or folder.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="MusicContent" PersistedName="FileNameAndExtension" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="Extension" Visible="false" ReadOnly="true">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="MusicContent" PersistedName="Extension" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="URL" ReadOnly="true" Visible="false">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="MusicContent" PersistedName="FullPath" />
    </StringProperty.DataSource>
  </StringProperty>

  <BoolProperty Name="Visible" Visible="false" />

  <StringProperty Name="DependentUpon" Visible="false">
    <StringProperty.Metadata>
      <NameValuePair Name="DoNotCopyAcrossProjects" Value="true" />
    </StringProperty.Metadata>
  </StringProperty>

  <StringProperty Name="Link" Visible="false">
    <StringProperty.Metadata>
      <NameValuePair Name="DoNotCopyAcrossProjects" Value="true" />
    </StringProperty.Metadata>
  </StringProperty>

</Rule>
