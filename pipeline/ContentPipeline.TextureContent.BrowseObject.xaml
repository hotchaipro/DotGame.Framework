<?xml version="1.0" encoding="utf-8"?>
<!--
    Properties pane (browse object) for TextureContent items.

    Must be a standalone <Rule> file registered with Context="File;BrowseObject";
    rules placed inside a <ProjectSchemaDefinitions> container are only read for
    the item-type/content-type registrations that container is meant to carry,
    so their properties never reach the Properties window.  Every rule VS ships
    (None.xaml, Content.xaml, ...) follows this one-rule-per-file shape.

    Registered by ContentPipeline.targets.
-->
<Rule Name="TextureContent"
      DisplayName="Texture Content"
      PageTemplate="generic"
      Description="Source image processed into a runtime texture by the content pipeline."
      xmlns="http://schemas.microsoft.com/build/2009/properties">

  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="False" ItemType="TextureContent" />
  </Rule.DataSource>

  <Rule.Categories>
    <Category Name="ContentPipeline" DisplayName="Content Pipeline" />
    <Category Name="Advanced" DisplayName="Advanced" />
    <Category Name="Misc" DisplayName="Misc" />
  </Rule.Categories>

  <DynamicEnumProperty Name="{}{ItemType}"
                       DisplayName="Build Action"
                       Category="Advanced"
                       Description="How the file relates to the build and deployment processes."
                       EnumProvider="ItemTypes" />

  <EnumProperty Name="Compression"
                DisplayName="Compression"
                Description="Selects the codec used to encode the texture: Lossless (default) keeps every pixel's color, exactly or within LosslessQuality, and keeps sharp edges and flat colors; Lossy only looks right, at LossyQuality, and is smaller for photographic art."
                Category="ContentPipeline">
    <EnumValue Name="Lossless" DisplayName="Lossless" IsDefault="true" />
    <EnumValue Name="Lossy" DisplayName="Lossy" />
  </EnumProperty>

  <IntProperty Name="LosslessQuality"
               DisplayName="Lossless Quality"
               Description="Quality scale 1..10 (default 10) for Lossless compression only: 10 is exact, lower lets colors change a little where that saves bytes, never further than asked for. An error with Compression=Lossy."
               Category="ContentPipeline"
               MinValue="1"
               MaxValue="10" />

  <IntProperty Name="LossyQuality"
               DisplayName="Lossy Quality"
               Description="Quality scale 1..10 (default 8) for Lossy compression only. An error with Compression=Lossless."
               Category="ContentPipeline"
               MinValue="1"
               MaxValue="10" />

  <BoolProperty Name="GpuCompression"
                DisplayName="GPU Compression"
                Description="Whether to store the texture in a format the platform's GPU samples compressed (default false): ASTC on Android and iOS, a quarter of the memory or less, with nothing to decode at load, but larger to download than lossy WebP. GPU formats are lossy, so the texture is too. Platforms without one use their lossy encoding."
                Category="ContentPipeline" />

  <BoolProperty Name="PremultiplyAlpha"
                DisplayName="Premultiply Alpha"
                Description="Whether to premultiply the color channels by alpha at build time (default true). Set to false for textures whose channels hold data rather than color, such as MSDF font atlases, so they are stored exactly as in the source."
                Category="ContentPipeline" />

  <!--
    CopyToOutputDirectory is intentionally absent: the pipeline stages its own
    processed output (_CopyContentToOutputDirectory / static web assets), so the
    metadata would have no effect on these items.
  -->

  <BoolProperty Name="Preload"
                DisplayName="Preload"
                Description="Whether the game needs this before its first frame (default false). On the web, the page starts downloading it at once, alongside the game's code; elsewhere content is read from the app, so it changes nothing."
                Category="ContentPipeline" />

  <StringProperty Name="Identity" Visible="false" ReadOnly="true" Category="Misc"
                  Description="The item specified in the Include attribute.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="TextureContent" PersistedName="Identity" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="FullPath" DisplayName="Full Path" ReadOnly="true" Category="Misc"
                  Description="Location of the file.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="TextureContent" PersistedName="FullPath" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="FileNameAndExtension" DisplayName="File Name" ReadOnly="true" Category="Misc"
                  Description="Name of the file or folder.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="TextureContent" PersistedName="FileNameAndExtension" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="Extension" Visible="false" ReadOnly="true">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="TextureContent" PersistedName="Extension" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="URL" ReadOnly="true" Visible="false">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="TextureContent" PersistedName="FullPath" />
    </StringProperty.DataSource>
  </StringProperty>

  <BoolProperty Name="Visible" Visible="false" />

  <StringProperty Name="DependentUpon" Visible="false">
    <StringProperty.Metadata>
      <NameValuePair Name="DoNotCopyAcrossProjects" Value="true" />
    </StringProperty.Metadata>
  </StringProperty>

  <!--
    Link drives the output-relative path for every pipeline item, so it must be
    declared here for CPS to round-trip it; it stays hidden to match the Link
    handling in the SDK's own item rules.
  -->
  <StringProperty Name="Link" Visible="false">
    <StringProperty.Metadata>
      <NameValuePair Name="DoNotCopyAcrossProjects" Value="true" />
    </StringProperty.Metadata>
  </StringProperty>

</Rule>
