<Project>

    <!--
        Built for a game (DotGameBuildRoot, which DotGame.Framework.targets passes to a game's project
        references): output in the game's folder, so games don't share these projects' obj and bin
        folders and can build at the same time, as can each game's platforms. Imported by the
        repository's Directory.Build.props and the samples'.
    -->
    <PropertyGroup Condition="'$(DotGameBuildRoot)' != ''">
        <!--
            A web game's AOT publish builds its references a second time, in a nested publish
            (WasmBuildingForNestedPublish), with other properties. That build gets folders of its own: in
            the same ones, on .NET 11, the two builds' static web assets (the WebGL platform's compressed
            scripts, the runtime's webcil files) overwrite each other's lists, and compression then fails
            with "Endpoints not found".
        -->
        <_DotGameBuildFolderSuffix Condition="'$(WasmBuildingForNestedPublish)' == 'true'">-nested</_DotGameBuildFolderSuffix>
        <BaseIntermediateOutputPath>$(DotGameBuildRoot)$(MSBuildProjectName)\obj$(_DotGameBuildFolderSuffix)\</BaseIntermediateOutputPath>
        <BaseOutputPath>$(DotGameBuildRoot)$(MSBuildProjectName)\bin$(_DotGameBuildFolderSuffix)\</BaseOutputPath>
        <!--
            NuGet's restore output stays in the project's own obj folder: restore evaluates each project
            without the game's property, and its output is the same for every game.
        -->
        <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)\obj\</MSBuildProjectExtensionsPath>
        <!-- The project's own obj and bin folders aren't the build's any more, so they're not excluded by default -->
        <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
        <!--
            A web game's publish asks its references for their static web assets with the properties
            each reference declares here (the WebGL platform project runs its WebAssembly publish then),
            not with the reference's own, so the property is declared for those calls too.
        -->
        <StaticWebAssetsAdditionalBuildProperties>$(StaticWebAssetsAdditionalBuildProperties);DotGameBuildRoot=$(DotGameBuildRoot)</StaticWebAssetsAdditionalBuildProperties>
        <StaticWebAssetsAdditionalPublishProperties>$(StaticWebAssetsAdditionalPublishProperties);DotGameBuildRoot=$(DotGameBuildRoot)</StaticWebAssetsAdditionalPublishProperties>
    </PropertyGroup>

    <!-- Passed on to this project's own references, so everything it builds goes in the game's folder -->
    <ItemDefinitionGroup Condition="'$(DotGameBuildRoot)' != ''">
        <ProjectReference>
            <AdditionalProperties>DotGameBuildRoot=$(DotGameBuildRoot)</AdditionalProperties>
        </ProjectReference>
    </ItemDefinitionGroup>

</Project>
