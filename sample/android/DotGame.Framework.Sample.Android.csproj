<Project Sdk="Microsoft.NET.Sdk">

    <!-- Android: OpenGL ES 3. Needs the android workload. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0-android</TargetFramework>
        <RootNamespace>Sample</RootNamespace>
        <ApplicationId>com.dotgame.framework.sample</ApplicationId>
        <ApplicationTitle>DotGame Framework Sample</ApplicationTitle>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <!-- The theme the launch screen's theme (DotGame.LaunchScreen) derives from -->
        <LaunchScreenAndroidThemeParent>@android:style/Theme.DeviceDefault.NoActionBar</LaunchScreenAndroidThemeParent>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <AndroidStripNativeLibraries>true</AndroidStripNativeLibraries>
    </PropertyGroup>

    <!-- The game's code, shared by every platform: a shared project, compiled into each platform's -->
    <Import Project="..\shared\DotGame.Framework.Sample.projitems" Label="Shared" />

    <!-- The launch screen, which the content pipeline makes into this platform's form -->
    <ItemGroup Label="Launch screen">
        <LaunchScreen Include="..\Content\LaunchScreen\logo.png" Background="#181c28" LogoSize="140" />
    </ItemGroup>

    <ItemGroup Label="Content">
        <TextureContent Include="..\Content\Textures\*.png">
            <LinkBase>Content\Textures</LinkBase>
        </TextureContent>
        <SoundContent Include="..\Content\Sound\*.wav">
            <LinkBase>Content\Sound</LinkBase>
        </SoundContent>
        <MusicContent Include="..\Content\Music\*.wav">
            <LinkBase>Content\Music</LinkBase>
        </MusicContent>
        <ShaderContent Include="..\Content\Shaders\*.slang">
            <LinkBase>Content\Shaders</LinkBase>
        </ShaderContent>
        <DataContent Include="..\Content\Data\*.*">
            <LinkBase>Content\Data</LinkBase>
        </DataContent>
    </ItemGroup>

</Project>
