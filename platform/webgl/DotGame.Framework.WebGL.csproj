<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <OutputType>Library</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <InvariantTimezone>true</InvariantTimezone>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <RunAOTCompilation>true</RunAOTCompilation>
        <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <WasmEnableSIMD>true</WasmEnableSIMD>
        <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
        <EventSourceSupport>false</EventSourceSupport>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    </PropertyGroup>

    <!--
        The nested publish that a game runs for AOT (WasmBuildingForNestedPublish) builds this project
        again. On .NET 11 its compression step then finds the runtime's webcil assets without their
        endpoints and fails ("Endpoints not found for related asset"). The outer publish compresses the
        game's output itself, so the nested build doesn't compress this project's assets.
    -->
    <PropertyGroup Condition="'$(WasmBuildingForNestedPublish)' == 'true'">
        <CompressionEnabled>false</CompressionEnabled>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\framework\DotGame.Framework.csproj" />
    </ItemGroup>

    <ItemGroup>
        <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
    </ItemGroup>

    <!--
    Prevent this library project's static web assets manifest files from being
    copied to the output directory of referencing projects. The consuming project
    generates its own combined manifest. If both are present, the WasmAppHost
    may pick the wrong one (alphabetically first), causing a 404 at runtime.
    -->
    <Target Name="_SuppressLibraryStaticWebAssetsManifestOutput" AfterTargets="AddStaticWebAssetsManifest;AddStaticWebAssetEndpointsBuildManifest" BeforeTargets="GetCopyToOutputDirectoryItems">
        <ItemGroup>
            <ContentWithTargetPath Remove="@(ContentWithTargetPath)" Condition="'%(TargetPath)' == '$(TargetName).staticwebassets.runtime.json' or '%(TargetPath)' == '$(TargetName).staticwebassets.endpoints.json'" />
        </ItemGroup>
    </Target>

    <!--
        Prevent this library project from exporting any _framework/ assets in its
        StaticWebAssets manifest. This covers WasmResource items (runtime, symbol,
        native, settings, manifest) and their compressed variants (.gz/.br).
        Sample references WebGL and independently computes all of these assets from its
        own ReferenceCopyLocalPaths (SourceType:Computed/Sample). If WebGL also exports
        them via its manifest (SourceType:Project/WebGL), GenerateStaticWebAssetsManifest
        rejects duplicates with a conflicting-target-path error.
        Running BeforeTargets="GenerateStaticWebAssetsManifest" ensures the compression
        pipeline (ResolveCompressedFiles → ApplyCompressionNegotiation) has already
        completed before we strip the items from the manifest.
    -->
    <Target Name="_SuppressWasmFrameworkStaticWebAssets" BeforeTargets="GenerateStaticWebAssetsManifest">
        <ItemGroup>
            <StaticWebAsset Remove="@(StaticWebAsset)" Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('_framework/'))" />
            <StaticWebAssetEndpoint Remove="@(StaticWebAssetEndpoint)" Condition="$([System.String]::Copy('%(StaticWebAssetEndpoint.AssetFile)').Contains('_framework'))" />
        </ItemGroup>
    </Target>

    <!--
        The platform's scripts (wwwroot/_dotgame/*.js) as a Release build serves them: without their
        comments and indentation (pipeline/tasks/_StripScriptComments.cs), which are most of their
        download. Lines stay where they are, so crash reports point at the source. The copies replace
        the sources as this project's static web assets, so their fingerprints, integrity and
        compressed copies are the served files'. A game built from the packages gets the same from
        the package's targets (packaging/buildTransitive/DotGame.Framework.WebGL).
    -->
    <Import Project="..\..\pipeline\ContentPipeline.Tasks.targets" />
    <UsingTask TaskName="_StripScriptComments" AssemblyFile="$(FrameworkContentPipelineTasksAssembly)" />

    <Target Name="_StripWebScriptComments"
            BeforeTargets="ResolveProjectStaticWebAssets"
            DependsOnTargets="_BuildContentPipelineTasks"
            Condition="'$(Configuration)' == 'Release' and '$(NoBuild)' != 'true'">
        <!--
            One folder for a game's build and its AOT publish's nested build (eng/DotGame.BuildRoot.props
            gives that one obj-nested): the game's publish takes this project's assets from both, and
            two files for one script would be two assets on one path.
        -->
        <PropertyGroup>
            <_StrippedWebScriptsRoot>$(IntermediateOutputPath)dotgame-scripts/</_StrippedWebScriptsRoot>
            <_StrippedWebScriptsRoot Condition="'$(DotGameBuildRoot)' != ''">$(DotGameBuildRoot)$(MSBuildProjectName)/dotgame-scripts/$(Configuration)/</_StrippedWebScriptsRoot>
            <_StrippedWebScriptsRoot>$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(_StrippedWebScriptsRoot)'))'))</_StrippedWebScriptsRoot>
        </PropertyGroup>
        <ItemGroup>
            <_WebScript Include="wwwroot\_dotgame\*.js" />
        </ItemGroup>

        <_StripScriptComments Scripts="@(_WebScript)" OutputDirectory="$(_StrippedWebScriptsRoot)_dotgame">
            <Output TaskParameter="StrippedScripts" ItemName="_StrippedWebScript" />
        </_StripScriptComments>

        <ItemGroup>
            <Content Remove="@(_WebScript)" />
            <_StrippedWebScriptCandidate Include="@(_StrippedWebScript)" RelativePath="_dotgame/%(Filename)#[.{fingerprint}]!%(Extension)" />
            <FileWrites Include="@(_StrippedWebScript)" />
        </ItemGroup>

        <DefineStaticWebAssets
            CandidateAssets="@(_StrippedWebScriptCandidate)"
            SourceType="Discovered"
            SourceId="$(PackageId)"
            ContentRoot="$(_StrippedWebScriptsRoot)"
            BasePath="$(StaticWebAssetBasePath)"
            AssetKind="All"
            AssetMode="All"
            AssetRole="Primary"
            AssetMergeSource="$(StaticWebAssetMergeTarget)"
            FingerprintCandidates="false"
            CopyToOutputDirectory="Never"
            CopyToPublishDirectory="PreserveNewest">
            <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
            <Output TaskParameter="Assets" ItemName="_StrippedWebScriptAsset" />
        </DefineStaticWebAssets>

        <DefineStaticWebAssetEndpoints
            CandidateAssets="@(_StrippedWebScriptAsset)"
            ExistingEndpoints="@(StaticWebAssetEndpoint)"
            ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
            <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
        </DefineStaticWebAssetEndpoints>
    </Target>

    <PropertyGroup>
        <DefaultShaderTarget>glsl</DefaultShaderTarget>
        <DefaultShaderNamespace>DotGame.Framework.WebGL.Graphics</DefaultShaderNamespace>
    </PropertyGroup>

    <Import Project="..\shared\DotGame.Framework.Platform.Common.projitems" Label="Shared" />

    <Import Project="..\shared\DefaultShaders.targets" />
    <Import Project="..\..\pipeline\WebAssembly.LegacyExceptions.targets" />

    <Import Project="..\..\eng\DotGame.PublicApi.props" />
</Project>
