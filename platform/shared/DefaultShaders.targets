<Project>

    <!--
        DefaultShaders.targets

        Compiles the framework's default sprite shader, Shaders/sprite.slang
        (next to this file), into a generated C# source file containing
        platform-specific shader data as compile-time constants. It runs when a
        platform project builds, so the platform assembly carries the default
        shader and a game's build never compiles it.

        Shader compilation and the C# source wrapper are produced by the
        default-shaders command of the content pipeline build tool (see
        ..\..\pipeline\ContentPipeline.BuildTool.props); this target only
        orchestrates the build.

        Required properties (set by the importing project before Import):
            DefaultShaderTarget      'spirv' for desktop, 'msl' for iOS, 'glsl' for WebGL
            DefaultShaderNamespace   C# namespace for the generated source file
    -->

    <Import Project="..\..\pipeline\ExternalTools.props" Condition="'$(_ExternalToolsImported)' != 'true'" />

    <!-- ──────── Source path ──────── -->

    <PropertyGroup>
        <_DefaultShaderSource>$(MSBuildThisFileDirectory)Shaders\sprite.slang</_DefaultShaderSource>
    </PropertyGroup>

    <!-- ──────── Output location ──────── -->

    <!--
        The generated C# wrapper is treated as build-time generated source,
        analogous to a Roslyn source generator's output: it lives under the
        project's IntermediateOutputPath (obj) and is regenerated by
        'dotnet clean' / Rebuild.  Within incremental builds, the
        Inputs/Outputs check on _CompileDefaultShaders skips regeneration
        when the source and the build tool are unchanged.

        Path resolution happens inside _ResolveDefaultShaderOutput rather
        than at evaluation time because $(IntermediateOutputPath) is
        populated by the SDK targets that import after this file.
        Resolving early would produce a path outside obj that the SDK's
        default <Compile> glob also picks up, causing CS2002 duplicates.
    -->

    <!-- ──────── Compile target ──────── -->

    <Target Name="_ValidateDefaultShaders">
        <Error Condition="'$(DefaultShaderTarget)' == ''"
                      Text="DefaultShaderTarget property must be set to 'spirv', 'msl', or 'glsl' before importing DefaultShaders.targets." />

        <Error Condition="'$(DefaultShaderNamespace)' == ''"
                      Text="DefaultShaderNamespace property must be set before importing DefaultShaders.targets." />
    </Target>

    <!--
        _ResolveDefaultShaderOutput – computes the output path and registers
        the generated file as a Compile item.  Always runs (no Inputs/
        Outputs) so the Compile item is present even when the codegen
        target is skipped by its incremental check.
    -->
    <Target Name="_ResolveDefaultShaderOutput"
                    BeforeTargets="_CompileDefaultShaders;BeforeCompile"
                    DependsOnTargets="_ValidateDefaultShaders">
        <PropertyGroup>
            <_DefaultShaderOutputDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'DefaultShaders'))</_DefaultShaderOutputDir>
            <_DefaultShaderOutputFile>$(_DefaultShaderOutputDir)\DefaultShaderSource.g.cs</_DefaultShaderOutputFile>
        </PropertyGroup>
        <ItemGroup>
            <Compile Include="$(_DefaultShaderOutputFile)" />
        </ItemGroup>
    </Target>

    <!--
        Skip the shader Exec during Visual Studio design-time / IntelliSense
        builds.  VS runs frequent design-time builds (including immediately
        after a Clean) that evaluate targets up through BeforeCompile.  Without
        this guard each one spawns the build tool + slangc, which stalls the VS build
        host and shows up as Clean / build "hanging" even though CLI builds
        (which never run design-time builds) work fine.  _ResolveDefaultShaderOutput
        still runs so the generated file remains registered for IntelliSense; the
        Exec only runs for real builds.
    -->
    <Target Name="_CompileDefaultShaders"
                    Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildingProject)' != 'false'"
                    BeforeTargets="BeforeCompile"
                    DependsOnTargets="_ResolveDefaultShaderOutput;_ResolveContentPipelineBuildTool"
                    Inputs="$(_DefaultShaderSource);$(ContentPipelineBuildToolPath);$(MSBuildThisFileFullPath)"
                    Outputs="$(_DefaultShaderOutputFile)">

        <Message Text="Compiling default shaders..." Importance="high" />

        <MakeDir Directories="$(_DefaultShaderOutputDir)" />

        <Exec Command="$(ContentPipelineBuildCommand) default-shaders --slangc $(SlangCPath) --spirv-cross $(SpirvCrossPath) --spirv2dxil $(Spirv2DxilPath) --input &quot;$(_DefaultShaderSource)&quot; --output-dir &quot;$(_DefaultShaderOutputDir)&quot; --target &quot;$(DefaultShaderTarget)&quot; --namespace &quot;$(DefaultShaderNamespace)&quot;"
                    WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>

</Project>
