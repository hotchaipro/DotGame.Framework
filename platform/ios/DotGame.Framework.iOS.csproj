<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0-ios</TargetFramework>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <OutputType>Library</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <InvariantTimezone>true</InvariantTimezone>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\framework\DotGame.Framework.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <DefaultShaderTarget>msl</DefaultShaderTarget>
        <DefaultShaderNamespace>DotGame.Framework.iOS.Graphics</DefaultShaderNamespace>
    </PropertyGroup>

    <!-- Decodes audio in managed code, with DotGame.AudioCodecs (see the shared project) -->
    <PropertyGroup>
        <DotGameManagedAudioDecoding>true</DotGameManagedAudioDecoding>
    </PropertyGroup>
    <Import Project="..\shared\DotGame.Framework.Platform.Common.projitems" Label="Shared" />
    <Import Project="..\shared\DefaultShaders.targets" />

    <Import Project="..\..\eng\DotGame.PublicApi.props" />
</Project>
